# Backend
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Both hosts — open the UI on ONE of them and keep it (cookies are host-bound)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# System Postgres (no Docker required). Role/DB created once on the host.
POSTGRES_DB=depress
POSTGRES_USER=depress
POSTGRES_PASSWORD=depress
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# AI (optional — empty = offline soft replies)
# DeepSeek: https://api.deepseek.com  model deepseek-chat
# Or xAI-compatible: AI_BASE_URL=https://api.x.ai/v1 AI_MODEL=grok-4.5
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Dedicated translator (OpenAI-compatible). Empty URL = AI gateway / offline stub.
# Specialized MT model via Ollama (Hunyuan-MT-7B GGUF, 33 languages, no API key):
#   ollama pull hf.co/mradermacher/Hunyuan-MT-7B-GGUF:Q4_K_M
# llama.cpp alternative: TRANSLATOR_BASE_URL=http://127.0.0.1:8088/v1
TRANSLATOR_BASE_URL=
TRANSLATOR_MODEL=hf.co/mradermacher/Hunyuan-MT-7B-GGUF:Q4_K_M
TRANSLATOR_API_KEY=
# Seconds per call; the first call also loads the model into RAM.
TRANSLATOR_TIMEOUT=60

# Frontend (REST same-origin via Next rewrites; WS host follows the page)
NEXT_PUBLIC_API_URL=http://localhost:8005
NEXT_PUBLIC_WS_URL=ws://localhost:8005
PUBLIC_BASE_URL=http://127.0.0.1:5174

# Telegram Mini App host (BotFather token). Empty = /auth/telegram disabled.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (for soft-notify deep links t.me/<user>?startapp=…)
TELEGRAM_BOT_USERNAME=
# Bot lobby webhook. Secret must match `setup_telegram_bot` setWebhook
# secret_token. Empty = /api/v1/bot/webhook is disabled.
TELEGRAM_BOT_WEBHOOK_SECRET=
# Optional full public webhook URL; empty = PUBLIC_BASE_URL + /api/v1/bot/webhook
TELEGRAM_BOT_WEBHOOK_URL=
# Daily Telegram digest schedule (UTC), Celery beat
TELEGRAM_DIGEST_HOUR=10
TELEGRAM_DIGEST_MINUTE=0
# Neutral check-in nudge (opt-in only, blind to local check-ins — ADR-0025).
# At most one per TELEGRAM_NUDGE_INTERVAL_DAYS; skipped if a digest went out today.
TELEGRAM_NUDGE_HOUR=19
TELEGRAM_NUDGE_MINUTE=0
TELEGRAM_NUDGE_INTERVAL_DAYS=3

# Non-custodial public fund (ADR-0020). Empty address hides the fund block.
# Treasury = Squads Multisig vault; the platform never moves money.
TREASURY_SOLANA_ADDRESS=
TREASURY_SQUADS_URL=
# Duty accounting: lazy stale-close gap and per-helper daily credit cap.
FUND_STALE_GAP_MINUTES=15
FUND_MAX_MINUTES_PER_DAY=600

# Live 1:1 voice (ADR 0021). Self-hosted coturn TURN/STUN; empty = direct
# candidates only (LAN / permissive NAT). See DEPLOY.md §8.1.
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# SQLite: ONLY for pytest. Never set for daphne/dev.
# DEPRESS_USE_SQLITE=1 CHANNEL_LAYER=memory pytest

# Prod env for de-press — copy to /etc/depress/depress.env, fill secrets, chmod 600.
# DJANGO_SETTINGS_MODULE=config.settings.production is set in deploy/depress-api.service.template.

# Core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.depress.co
# One canonical origin; CSRF_TRUSTED_ORIGINS derives from this list (settings/base.py)
DJANGO_CORS_ALLOWED_ORIGINS=https://app.depress.co
PUBLIC_BASE_URL=https://app.depress.co

# System Postgres (role/DB created once on the host)
POSTGRES_DB=depress
POSTGRES_USER=depress
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# System Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Email (optional; default console/local smtp)
# DJANGO_EMAIL_HOST=localhost
# DJANGO_EMAIL_PORT=25
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=de-press@app.depress.co

# AI empath support (optional — empty = offline soft replies)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Dedicated translator (optional — empty = AI gateway / offline stub)
TRANSLATOR_BASE_URL=
TRANSLATOR_MODEL=Hy-MT1.5-1.8B
TRANSLATOR_API_KEY=

# Telegram (empty = /auth/telegram disabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Bot lobby webhook secret; matches secret_token passed to setWebhook.
TELEGRAM_BOT_WEBHOOK_SECRET=
# Optional full public webhook URL; empty = PUBLIC_BASE_URL + /api/v1/bot/webhook
TELEGRAM_BOT_WEBHOOK_URL=
TELEGRAM_DIGEST_HOUR=10
TELEGRAM_DIGEST_MINUTE=0
# Neutral check-in nudge (opt-in only, blind to local check-ins — ADR-0025).
TELEGRAM_NUDGE_HOUR=19
TELEGRAM_NUDGE_MINUTE=0
TELEGRAM_NUDGE_INTERVAL_DAYS=3
